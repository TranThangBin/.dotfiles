export GBM_BACKEND="nvidia-drm"
export __GLX_VENDOR_LIBRARY_NAME="nvidia"
export LIBVA_DRIVER_NAME="nvidia"
export ELECTRON_OZONE_PLATFORM_HINT="auto"

export PATH={{ list (joinPath .dotfilesDir "bin") "$PATH" "$HOME/.local/bin" | join ":" | quote }}
export XDG_DATA_DIRS={{ list (joinPath .dotfilesDir "share") "$XDG_DATA_DIRS" | join ":" | quote }}
export XDG_CONFIG_DIRS="$XDG_CONFIG_HOME:$XDG_CONFIG_DIRS"

export QT_QPA_PLATFORMTHEME="gtk3"

export GOPASS_CLIPBOARD_COPY_CMD="$XDG_DATA_HOME/gopass/scripts/gopass_clipboard_copy_cmd.sh"
export GOPASS_CLIPBOARD_CLEAR_CMD="$XDG_DATA_HOME/gopass/scripts/gopass_clipboard_clear_cmd.sh"

export DBX_SKIP_WORKDIR=1

# vim: set ft=env :
